{
    "name": "kasunsampath/laravel-dialog-esms",
    "description": "Laravel integration for Dialog eSMS (Sri Lanka) — sending, bulk campaigns, balance checks, and delivery receipts.",
    "keywords": ["laravel", "sms", "dialog", "esms", "sri-lanka", "otp", "notification-channel"],
    "homepage": "https://github.com/kasunsampath/laravel-dialog-esms",
    "license": "MIT",
    "authors": [
        {
            "name": "Kasun Sampath",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "guzzlehttp/guzzle": "^7.5",
        "illuminate/contracts": "^10.0|^11.0|^12.0",
        "illuminate/http": "^10.0|^11.0|^12.0",
        "illuminate/support": "^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^10.5|^11.0"
    },
    "autoload": {
        "psr-4": {
            "KasunSampath\\DialogEsms\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "KasunSampath\\DialogEsms\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "KasunSampath\\DialogEsms\\DialogEsmsServiceProvider"
            ],
            "aliases": {
                "DialogEsms": "KasunSampath\\DialogEsms\\Facades\\DialogEsms"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
