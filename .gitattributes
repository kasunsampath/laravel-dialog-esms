# Normalise line endings so the repo stays LF regardless of who commits from
# Windows. Without this, checkouts on Windows commit CRLF back and every file
# shows as fully rewritten in diffs.
* text=auto eol=lf

# Keep development files out of the Composer dist archive. Consumers install
# the package, not its test suite, and this cuts what Packagist ships.
/.github            export-ignore
/tests              export-ignore
/.gitattributes     export-ignore
/.gitignore         export-ignore
/phpunit.xml        export-ignore
/CHANGELOG.md       export-ignore
